# Kopiraj ovaj fajl u .env i popuni stvarne vrijednosti. .env se NIKAD ne
# komituje u git (vidi .gitignore) — nijedan API key ne smije završiti na GitHubu.

ENVIRONMENT=development

# ArcGIS OAuth 2.0 "App authentication" credentials (Phase 1).
# Tvoja ArcGIS Online organizacija ima isključeno izdavanje plain API key
# credentials (admin security policy) — koristimo OAuth app-auth umjesto
# toga. Kreiraj credential: ArcGIS Online > Content > New item >
# Developer credentials > OAuth 2.0 credentials > "For app authentication".
# client_secret je tajna istog ranga kao OPENAI_API_KEY ispod — NIKAD u
# frontend kodu, NIKAD u git-u. Vidi app/services/arcgis_auth.py.
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=

# OpenAI API key — koristi se tek u Phase 13 (AI explanation layer).
# Aplikacija mora normalno raditi i bez njega (graceful degradation).
OPENAI_API_KEY=

# Ako se CORS origins razlikuju od defaulta u app/core/config.py, override-uj:
# CORS_ALLOW_ORIGINS=["https://<tvoj-username>.github.io"]
